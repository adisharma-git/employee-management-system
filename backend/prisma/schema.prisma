
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --------------------------------------
// 1. Users Table (Authentication)
// --------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   // 'admin', 'manager', 'employee'
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  employee       Employee?
  assignedTasks  Task[]   @relation("AssignedBy")
  approvedLeaves Leave[]  @relation("ApprovedBy")
  projectsCreated Project[] @relation("ProjectCreator")

  announcements  Announcement[] 
  meetings       Meeting[]      

  notifications  Notification[]

  @@map("users")
  @@index([email])
  @@index([role])
}

// --------------------------------------
// 2. Employees Table (Profile)
// --------------------------------------
model Employee {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  name          String
  department    String?
  designation   String?
  phone         String?
  dateOfJoining DateTime? @map("date_of_joining") @db.Date
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  dailyLogs     DailyLog[]

  // Relationships
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  leaves     Leave[]
  leaveBalances LeaveBalance[]
  tasks      Task[]
  salaryStructure SalaryStructure?
  payrollRecords  PayrollRecord[]

  @@map("employees")
  @@index([userId])
  @@index([department])
  @@index([name])
}

// --------------------------------------
// 3. Attendance Table
// --------------------------------------

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  date         DateTime  @db.Date               // Keep this! This is the "Shift Date"
  status       String    
  
  checkInTime  DateTime? @map("check_in_time")  
  checkOutTime DateTime? @map("check_out_time") 
  
  breakHistory      Json      @default("[]")   @map("break_history") 
  totalBreakMinutes Int       @default(0)      @map("total_break_minutes") 
  
  createdAt    DateTime  @default(now()) @map("created_at")

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendance")
  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// --------------------------------------
// 4. Leaves Table (Updated)
// --------------------------------------
model Leave {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  
  // Relational link to the Master Table
  leaveTypeId  String   @map("leave_type_id") 
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])

  fromDate     DateTime @map("from_date") @db.Date
  toDate       DateTime @map("to_date") @db.Date
  reason       String?  @db.Text
  isHalfDay    Boolean  @default(false) @map("is_half_day")
  appliedDays  Float    @map("applied_days") 
  status       String   @default("pending") // 'pending', 'approved', 'rejected'
  approvedBy   String?  @map("approved_by")
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver     User?    @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@map("leaves")
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
}

// --------------------------------------
// 5. Projects Table (The Kanban Boards)
// --------------------------------------
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  status      String   @default("active") // 'active', 'completed', 'archived'
  
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  author      User     @relation("ProjectCreator", fields: [createdBy], references: [id])
  tasks       Task[]   // A project contains many tasks

  @@map("projects")
  @@index([status])
}

// --------------------------------------
// 6. DailyLog
// --------------------------------------
model DailyLog {
  id          String   @id @default(uuid())
  
  // 1. The "Anchor" (Date)
  // We store the date so we know "Which day is this row for?"
  date        DateTime @default(now()) 
  
  // 2. The Link (Foreign Key)
  // This is how we connect this row to a specific Employee.
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])

  // 3. The "Magic Container" (JSON)
  // This holds the list: [{ item: "UI Fix", time: 2 }, { item: "Meeting", time: 1 }]
  workItems   Json     @default("[]") 

  // 4. Metadata
  totalHours  Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 5. The Rule (Constraint)
  // This effectively says: "An Employee cannot have TWO rows for the SAME date."
  // If they try to add a new task for today, we force an UPDATE, not a CREATE.
  @@unique([date, employeeId])
}

// --------------------------------------
// 7. Leave Balances Table (Updated)
// --------------------------------------
model LeaveBalance {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  
  // Relational link to the Master Table
  leaveTypeId  String   @map("leave_type_id")
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])

  allocated    Float    
  used         Float    @default(0) 

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  // Ensures an employee only has one balance record per specific Leave Type
  @@unique([employeeId, leaveTypeId]) 
  @@map("leave_balances")
}

// --------------------------------------
// 8. Holidays Table (The Calendar)
// --------------------------------------
model Holiday {
  id          String   @id @default(uuid())
  name        String   // e.g., "Independence Day"
  date        DateTime @unique @db.Date

  @@map("holidays")
}

// --------------------------------------
// 9. Leave Types Table (The Master Menu)
// --------------------------------------
model LeaveType {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "Casual", "Sick", "Maternity"
  defaultDays Float    @map("default_days") // The standard allocation (e.g., 10, 5)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active") // Admin can disable old policies

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships: A master leave type connects to many balances and many requests
  balances    LeaveBalance[]
  requests    Leave[]

  @@map("leave_types")
}

// --------------------------------------
// 10. Announcements Table
// --------------------------------------
model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  
  // We link this to the User (Admin) who created it, just for auditing
  createdBy   String   @map("created_by") 
  author      User     @relation(fields: [createdBy], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

// --------------------------------------
// 11. Meetings Table
// --------------------------------------
model Meeting {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  date        DateTime // Stores both date AND time
  meetLink    String?  @map("meet_link") // Optional: Google Meet / Zoom link
  
  createdBy   String   @map("created_by")
  author      User     @relation(fields: [createdBy], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("meetings")
}

// --------------------------------------
// 12. Notifications Table (Personal Inbox)
// --------------------------------------
model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") // The person receiving the alert
  title       String
  message     String   @db.Text
  type        String   // e.g., 'leave', 'announcement', 'meeting'
  isRead      Boolean  @default(false) @map("is_read") // Controls the red dot!
  
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([isRead])
}

// --------------------------------------
// 13. Salary Structure Table
// --------------------------------------
model SalaryStructure {
  id          String   @id @default(uuid())
  employeeId  String   @unique @map("employee_id")
  
  baseSalary  Float    @map("base_salary")
  allowances  Float    @default(0) 
  taxRate     Float    @default(0) @map("tax_rate") // e.g., 10 for 10% flat tax
  
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

// --------------------------------------
// 14. Payroll Records Table (Historical Payslips)
// --------------------------------------
model PayrollRecord {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  
  month          Int      // 1 to 12
  year           Int      // e.g., 2026
  
  // Snapshot of structure at the time of generation
  basicSalary    Float    @map("basic_salary")
  allowances     Float    @default(0)
  
  // Attendance metrics
  totalDays      Int      @map("total_days")
  payableDays    Float    @map("payable_days") 
  lopDays        Float    @map("lop_days") // Loss of Pay days
  
  // Financials
  grossEarnings  Float    @map("gross_earnings") 
  taxDeduction   Float    @map("tax_deduction") 
  netPay         Float    @map("net_pay")
  
  status         String   @default("generated") // 'generated', 'paid'
  
  createdAt      DateTime @default(now()) @map("created_at")

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Ensures we only generate one payslip per employee per month
  @@unique([employeeId, month, year]) 
  @@map("payroll_records")
}

// --------------------------------------
// 15. Tasks Table (The Kanban Cards)
// --------------------------------------
model Task {
  id          String   @id @default(uuid())
  
  // The Parent Board
  projectId   String   @map("project_id")
  
  // Assignees
  assignedTo  String   @map("assigned_to")
  assignedBy  String?  @map("assigned_by")
  
  // Task Details
  title       String
  description String?  @db.Text
  priority    String?  // 'low', 'medium', 'high'
  dueDate     DateTime? @map("due_date") @db.Date
  
  // Kanban Specifics
  status      String   @default("todo") // 'todo', 'in-progress', 'code-review', 'qa-testing', 'done'
  position    Int      @default(0)      // Controls the drag-and-drop visual order!
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relationships
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  assigner    User?    @relation("AssignedBy", fields: [assignedBy], references: [id])

  @@map("tasks")
  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
}