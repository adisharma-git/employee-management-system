            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveTypeId\": \"<paste-from-my-balances-or-leave-types>\",\n  \"description\": \"Personal work\",\n  \"startDate\": \"2026-03-20\",\n  \"endDate\": \"2026-03-20\",\n  \"isHalfDay\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "apply"]
            }
          }
        },
        {
          "name": "Get My Leave History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/my-history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "my-history"]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Admin",
      "item": [
        {
          "name": "Get Employees",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "employees"]
            }
          }
        },
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Employee\",\n  \"email\": \"new.employee@example.com\",\n  \"password\": \"TempPassword123\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Developer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "employees"]
            }
          }
        },
        {
          "name": "All Employees Attendance (optional date)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/all-employees-attendance?date=2026-03-14",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "all-employees-attendance"],
              "query": [
                { "key": "date", "value": "2026-03-14" }
              ]
            }
          }
        },
        {
          "name": "Get All Leaves (optional status)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/leaves/all?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "all"],
