              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leaves/{{leaveId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leaves", "{{leaveId}}", "status"]
            }
          }
        },
        {
          "name": "Create Leave Type",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Special Leave\",\n  \"defaultDays\": 2,\n  \"description\": \"Special policy leave\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/leave-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "leave-types"]
            }
          }
        },
        {
          "name": "Create Announcement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Holiday Notice\",\n  \"content\": \"Office will remain closed on public holiday.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "announcements"]
            }
          }
        },
        {
          "name": "Get Announcements",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/announcements?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "announcements"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    }
  ]
}
